# Configuração de uma instância (uma empresa cliente por deploy — D-009).
# Copie para .env em desenvolvimento; em produção use as variáveis do provedor.

# Obrigatórias em produção (a aplicação não sobe sem elas)
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
ALLOWED_HOSTS=nutri.suaempresa.com.br

# Banco desta empresa (cada instância tem o seu)
DATABASE_URL=postgres://usuario:senha@localhost:5432/nutri

# Opcionais
DEBUG=False
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
# Ativar somente se TODOS os subdomínios servirem HTTPS (efeito difícil de reverter)
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SESSION_COOKIE_AGE=43200
CONN_MAX_AGE=60

# Provisionamento inicial (bootstrap_instancia) — alternativa a --senha
# INSTANCIA_ADMIN_SENHA=senha-do-primeiro-administrador
