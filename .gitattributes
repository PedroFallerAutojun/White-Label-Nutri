# Normalização de fim de linha por tipo de arquivo.
* text=auto

# Scripts shell precisam de LF (CRLF quebra o shebang no bash/WSL).
*.sh text eol=lf

# Scripts do PowerShell precisam de CRLF; o BOM UTF-8 no conteúdo é obrigatório
# para o Windows PowerShell 5.1 interpretar acentos corretamente.
*.ps1 text eol=crlf

# Dados binários não devem sofrer conversão.
*.gz binary
*.png binary
*.svg text
